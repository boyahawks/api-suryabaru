# Server
PORT=3500
HOST=0.0.0.0

# MySQL Database
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Database Backup (cron setiap jam 00:00 Asia/Jakarta, hanya 1 file)
BACKUP_DIR=./backups
BACKUP_CRON=0 0 * * *
BACKUP_TZ=Asia/Jakarta
# true = verifikasi sertifikat SSL server (default false untuk hosting self-signed)
BACKUP_SSL_VERIFY=false

# JWT
JWT_SECRET=

# Basic Auth
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
